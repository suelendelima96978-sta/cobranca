old.id||uid(),debtorId:people.get(dk).id,creditorId:clients.get(ck).id,type:old.kind||'Boleto',situation:old.stage||'Extrajudicial',status:old.status==='paid'||old.status==='settled'?'settled':'open',amount:Number(old.amount||0),due:old.due||today(),process:old.reference||'',notes:old.notes||'',createdAt:old.createdAt||new Date().toISOString(),settledAt:''})}return data}
function normalizeCloudData(value){let result={...emptyDb(),...(value&&typeof value==='object'?value:{})};for(const key of Object.keys(emptyDb()))if(!Array.isArray(result[key]))result[key]=[];return result}
function mergeCloudData(base,local,remote){let merged={};for(const key of Object.keys(emptyDb())){let b=base[key]||[],l=local[key]||[],r=remote[key]||[],bm=new Map(b.map(x=>[x.id,x])),lm=new Map(l.map(x=>[x.id,x])),rm=new Map(r.map(x=>[x.id,x])),ids=[...new Set([...l,...r,...b].map(x=>x.id))],out=[];for(const id of ids){let before=bm.get(id),ours=lm.get(id),theirs=rm.get(id),oursChanged=JSON.stringify(ours)!==JSON.stringify(before),chosen=oursChanged?ours:theirs;if(chosen!==undefined)out.push(chosen)}merged[key]=out}return merged}
function cloudHeaders(){return{'Authorization':'Bearer '+shareToken,'Content-Type':'application/json'}}
async function getCloudData(){let response=await fetch('/api/data',{method:'GET',headers:cloudHeaders(),cache:'no-store'});if(!response.ok)throw new Error(response.status===401?'Este link não tem autorização para os dados.':'Não foi possível conectar ao arquivo compartilhado.');return response.json()}
async function putCloudData(data,revision){let response=await fetch('/api/data',{method:'PUT',headers:cloudHeaders(),body:JSON.stringify({data,revision})});if(response.status===409)return{conflict:true};if(!response.ok){let body={};try{body=await response.json()}catch{}throw new Error(body.error||'Não foi possível sincronizar os registros.')}return response.json()}
async function syncCloud(){if(!cloudReady||!localDirty||syncBusy)return;syncBusy=true;let startedAt=localChangeVersion,base=normalizeCloudData(JSON.parse(lastSyncedSnapshot||'{}')),payload=normalizeCloudData(db);try{let result=await putCloudData(payload,cloudRevision);if(result.conflict){let latest=await getCloudData(),remote=normalizeCloudData(latest.data),firstMerge=mergeCloudData(base,payload,remote),currentMerge=mergeCloudData(payload,db,firstMerge);db=currentMerge;render();cloudRevision=Number(latest.revision);payload=normalizeCloudData(db);result=await putCloudData(payload,cloudRevision);if(result.conflict)throw new Error('Houve alterações simultâneas. Aguarde a atualização e tente salvar novamente.')}cloudRevision=Number(result.revision);lastSyncedSnapshot=JSON.stringify(payload);localDirty=localChangeVersion!==startedAt;if(localDirty){clearTimeout(window.acervoSyncTimer);window.acervoSyncTimer=setTimeout(syncCloud,400)}}catch(error){localDirty=true;toast(error.message||'Falha ao sincronizar. Mantenha esta página aberta e tente novamente.');clearTimeout(window.acervoSyncTimer);window.acervoSyncTimer=setTimeout(syncCloud,10000)}finally{syncBusy=false;if(localDirty&&!window.acervoSyncTimer)window.acervoSyncTimer=setTimeout(syncCloud,1000)}}
async function refreshCloud(){if(!cloudReady||localDirty||syncBusy)return;try{let latest=await getCloudData();if(Number(latest.revision)!==cloudRevision){let base=normalizeCloudData(JSON.parse(lastSyncedSnapshot||'{}'));db=mergeCloudData(base,db,normalizeCloudData(latest.data));cloudRevision=Number(latest.revision);lastSyncedSnapshot=JSON.stringify(db);render()}}catch(error){console.warn('Sincronização online indisponível',error)}}
function showOnlineGate(title,message){$('root').innerHTML='<main style="max-width:640px;margin:12vh auto;padding:32px;font:16px system-ui;color:#243333;background:#fff;border:1px solid #ddd;border-radius:16px"><h1 style="font:32px Georgia,serif">'+title+'</h1><p>'+message+'</p></main>'}
async function startOnlineApp(){if(!shareToken){showOnlineGate('Acesso pelo link completo','Abra o endereço compartilhado por quem administra o acervo. Os dados só podem ser acessados com o código que acompanha o link.');return}try{let state=await getCloudData();db=normalizeCloudData(state.data);cloudRevision=Number(state.revision);lastSyncedSnapshot=JSON.stringify(db);cloudReady=true;render();window.setInterval(refreshCloud,8000)}catch(error){showOnlineGate('Não foi possível abrir o acervo',error.message||'Verifique o link e a conexão com a internet.')}}function load(){return emptyDb()}function modal(html){$('modal').innerHTML=html;$('modalBack').classList.add('show')}function closeModal(){$('modalBack').classList.remove('show');$('modal').innerHTML=''}function badgeStatus(s,due){let key=s==='open'&&due&&due<today()?'overdue':s;return `<span class="badge ${key}">${key==='overdue'?'Vencida':STATUS[key]||key}</span>`}function situationBadge(s){return `<span class="badge ${s==='Judicial'?'judicial':'extra'}">${esc(s)}</span>`}
function casesWithPeople(){return db.cases.map(c=>({...c,scheduleItems:c.scheduleItems||[],chargeMode:c.chargeMode||'single',debtor:db.debtors.find(x=>x.id===c.debtorId)||{},creditor:db.creditors.find(x=>x.id===c.creditorId)||{},agreement:db.agreements.find(a=>a.caseId===c.id&&a.active)||null}))}function effectiveDue(c){if(c.status==='agreement'&&c.agreement){let due=db.installments.filter(i=>i.agreementId===c.agreement.id&&!i.paidAt).sort((a,b)=>a.due.localeCompare(b.due));if(due.length)return due[0].due}if(c.chargeMode==='installments'){let next=(c.scheduleItems||[]).filter(i=>!i.paidAt).sort((a,b)=>a.due.localeCompare(b.due))[0];if(next)return next.due}if(c.chargeMode==='fixed'&&c.firstDue)return c.firstDue;return c.due}function balance(c){if(c.status==='settled'||c.status==='suspended')return 0;if(c.status==='agreement'&&c.agreement)return db.installments.filter(i=>i.agreementId===c.agreement.id&&!i.paidAt).reduce((s,i)=>s+Number(i.amount||0),0);if(c.chargeMode==='installments')return (c.scheduleItems||[]).filter(i=>!i.paidAt).reduce((s,i)=>s+Number(i.amount||0),0);return Number(c.amount||0)}function moneyOptional(n){return n===null||n===undefined||n===''?'—':money(n)}function addScheduleDate(start,every,unit,index){let d=new Date(start+'T12:00:00'),n=every*index;if(unit==='days'){d.setDate(d.getDate()+n);return d.toISOString().slice(0,10)}if(unit==='weeks'){d.setDate(d.getDate()+7*n);return d.toISOString().slice(0,10)}let months=unit==='years'?12*n:n,month=new Date(d.getFullYear(),d.getMonth()+months,1),last=new Date(month.getFullYear(),month.getMonth()+1,0).getDate();return new Date(month.getFullYear(),month.getMonth(),Math.min(d.getDate(),last)).toISOString().slice(0,10)}function periodSpec(value,every,unit){return PERIODS[value]?[Number(PERIODS[value][0]),PERIODS[value][1]]:[Number(every||1),unit||'months']}function periodText(c){if(!c)return'Única';if(c.status==='agreement'&&c.agreement)return periodText({chargeMode:'installments',installmentCount:c.agreement.count,periodicity:c.agreement.periodicity||'monthly',periodEvery:c.agreement.periodEvery||1,periodUnit:c.agreement.periodUnit||'months'});if(c.chargeMode==='single')return'Única';let name=PERIODS[c.periodicity]?.[2]||(c.periodEvery===1?'Personalizada':'A cada '+c.periodEvery);if(c.periodicity==='custom')name='A cada '+c.periodEvery+' '+({days:'dia(s)',weeks:'semana(s)',months:'mês(es)',years:'ano(s)'}[c.periodUnit]||'mês(es)');return c.chargeMode==='fixed'?'Fixa · '+name:'Parcelada · '+(c.installmentCount||c.scheduleItems?.length||0)+' parcelas · '+name}const NAV=[['overview','⌂','Visão geral'],['cases','▤','Cobranças'],['debtors','♙','Devedores'],['creditors','▧','Credores'],['reports','▥','Relatórios'],['settings','⚙','Online']];function goto(v){view=v;render();window.scrollTo({top:0,behavior:'smooth'})}
function render(){let title={overview:'Visão geral',cases:'Cobranças',debtors:'Devedores',creditors:'Credores',reports:'Relatórios',settings:'Acesso e backups'}[view]||'Visão geral';$('root').innerHTML=`<div class="layout"><aside class="sidebar"><div class="brand"><span class="logo">A</span><span>ACERVO<small>/ acesso compartilhado</small></span></div><div class="side-label">Minha carteira</div>${NAV.map(n=>`<button class="nav ${view===n[0]?'active':''}" data-nav="${n[0]}"><span class="navicon">${n[1]}</span>${n[2]}</button>`).join('')}<div class="sidefoot"><b>Carteira compartilhada online</b>Link de acesso · sincronização online</div></aside><main class="main"><header class="topbar"><div><div class="eyebrow">Assessoria de cobrança</div><h1 class="page-title">${title}</h1><p class="page-subtitle">${{overview:'Resumo da carteira compartilhada e dos próximos vencimentos.',cases:'Organize títulos, processos, acordos e parcelas.',debtors:'Cadastre cada devedor uma vez para reutilizar depois.',creditors:'Seus clientes de assessoria de cobrança.' ,reports:'Consulte por nomes e períodos escolhidos por você.',settings:'Registros sincronizados para quem tem o link.'}[view]}</p></div><div class="top-actions"><span class="localmark"><span>●</span> compartilhado online</span><button class="button" data-action="import">↑ Importar backup</button><button class="button" data-action="backup">↓ Exportar backup</button><button class="button primary" data-action="new-case">＋ Nova cobrança</button></div></header><div id="content"></div></main></div>`;document.querySelectorAll('[data-nav]').forEach(b=>b.onclick=()=>goto(b.dataset.nav));renderView()}
function metric(label,value,note,icon){return `<div class="metric"><div class="metricline">${label}<span class="metricicon">${icon}</span></div><div class="metricvalue">${value}</div><div class="metricnote">${note}</div></div>`}
function caseTable(rows){return `<div class="table-wrap"><table class="table"><thead><tr><th>Devedor</th><th>Credor</th><th>Tipo de dívida</th><th>Forma</th><th>Vencimento</th><th>Valor original / acordo</th><th>Situação</th><th>Status</th><th></th></tr></thead><tbody>${rows.map(c=>`<tr><td><div class="mainname">${esc(c.debtor.name||'—')}</div><div class="sub">${c.debtor.cpf?'CPF '+esc(c.debtor.cpf):''}</div></td><td><div class="mainname">${esc(c.creditor.name||'—')}</div></td><td>${esc(c.type)}</td><td>${esc(periodText(c))}</td><td>${date(effectiveDue(c))}</td><td class="money">${moneyOptional(c.status==='agreement'&&c.agreement?c.agreement.total:c.amount)}</td><td>${situationBadge(c.situation)}</td><td>${badgeStatus(c.status,effectiveDue(c))}</td><td><div class="row-actions"><button class="iconbtn" title="Detalhes" data-action="detail-case" data-id="${c.id}">◉</button><button class="iconbtn" title="Editar" data-action="edit-case" data-id="${c.id}">✎</button><button class="iconbtn" title="Acordo e parcelas" data-action="agreement" data-id="${c.id}">▤</button></div></td></tr>`).join('')}</tbody></table></div>`}function overview(){let rows=casesWithPeople(),active=rows.filter(x=>!['settled','suspended'].includes(x.status)),over=active.filter(x=>effectiveDue(x)&&effectiveDue(x)<today()).length,jud=active.filter(x=>x.situation==='Judicial').length,total=active.reduce((s,x)=>s+balance(x),0),recent=active.slice().sort((a,b)=>effectiveDue(a).localeCompare(effectiveDue(b))).slice(0,8);return `<section class="metrics">${metric('Saldo em aberto',money(total),`${active.length} cobrança(s) ativa(s)`,'◉')}${metric('Vencidas',over,'Precisam de acompanhamento','◷')}${metric('Judiciais',jud,'Em acompanhamento judicial','⚖')}${metric('Credores',db.creditors.filter(x=>!x.archived).length,'Clientes cadastrados','♙')}</section><section class="panel"><div class="panelhead"><div><h2>Próximas cobranças</h2><p>Ordenadas pela data de vencimento</p></div><button class="button primary" data-action="new-case">＋ Nova cobrança</button></div>${recent.length?caseTable(recent):`<div class="empty"><b>Seu arquivo começa aqui</b>Lance uma cobrança diretamente; o credor precisa estar cadastrado.</div>`}</section><div class="notice"><b>Privacidade:</b> os registros são sincronizados pelo banco online e ficam acessíveis a quem tem o link completo. Exporte backups regularmente e mantenha-os em local protegido.</div>`}
function casesView(){return `<section class="panel"><div class="panelhead"><div><h2>Carteira de cobranças</h2><p>Pesquise por devedor, credor, CPF, título ou processo.</p></div><button class="button primary" data-action="new-case">＋ Nova cobrança</button></div><div class="toolbar"><div class="searchbox"><span>⌕</span><input id="caseSearch" placeholder="Buscar na carteira"></div><select id="caseSituation"><option value="">Judicial e extrajudicial</option><option>Judicial</option><option>Extrajudicial</option></select><select id="caseStatus"><option value="">Todos os status</option><option value="open">Em aberto</option><option value="agreement">Em acordo</option><option value="settled">Quitada</option><option value="suspended">Suspensa</option></select></div><div id="caseList">${caseTable(casesWithPeople())}</div><div class="empty hidden" id="caseEmpty"><b>Nenhuma cobrança encontrada</b>Altere a busca ou os filtros.</div></section>`}
function peopleView(kind){let debtor=kind==='debtor',items=debtor?db.debtors:db.creditors;return `<section class="panel"><div class="panelhead"><div><h2>${debtor?'Devedores':'Credores / clientes'}</h2><p>${debtor?'O cadastro do devedor pode ser escolhido em cobranças futuras.':'Cadastre seus clientes uma vez e selecione-os ao abrir uma cobrança.'}</p></div><button class="button primary" data-action="new-${kind}">＋ Novo ${debtor?'devedor':'credor'}</button></div><div class="toolbar"><div class="searchbox"><span>⌕</span><input id="peopleSearch" placeholder="Buscar por nome, documento ou contato"></div><select id="peopleArchive"><option value="active">Ativos</option><option value="all">Todos</option><option value="archived">Arquivados</option></select></div><div class="table-wrap"><table class="table"><thead><tr><th>Nome</th><th>${debtor?'CPF':'CPF / CNPJ'}</th><th>Telefone</th><th>${debtor?'Endereço':'E-mail'}</th><th>Cobranças</th><th>Cadastro</th><th></th></tr></thead><tbody id="peopleRows"></tbody></table></div><div class="empty hidden" id="peopleEmpty"><b>Nenhum cadastro encontrado</b>Adicione um novo registro para começar.</div></section>`}
