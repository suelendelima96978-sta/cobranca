<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#173f37">
<title>Acervo | Cobranças compartilhadas</title><meta name="robots" content="noindex,nofollow,noarchive">
<style>
:root{--green:#174b3f;--green2:#286250;--ink:#20312b;--muted:#74817c;--line:#e3e9e5;--paper:#f5f7f5;--white:#fff;--gold:#d9bb79;--red:#ac4a3e;--mint:#e8f2ec;--blue:#eff0fa;--shadow:0 18px 52px #173f371d}*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font:14px/1.5 "Segoe UI",Arial,sans-serif}button,input,select,textarea{font:inherit}button{cursor:pointer}.hidden{display:none!important}.layout{display:grid;grid-template-columns:235px minmax(0,1fr);min-height:100vh}.sidebar{position:sticky;top:0;height:100vh;background:var(--green);color:#eff8f3;padding:25px 16px;display:flex;flex-direction:column}.brand{display:flex;align-items:center;gap:11px;margin:0 8px 36px;font-size:15px;font-weight:750;letter-spacing:.05em}.brand small{display:block;color:#b8cec4;font-size:11px;font-weight:400;letter-spacing:0}.logo{width:36px;height:36px;border:1px solid #92b9a8;border-radius:11px;color:var(--gold);display:grid;place-items:center;font:22px Georgia,serif}.side-label{color:#9cb9ad;letter-spacing:.14em;font-size:10px;text-transform:uppercase;padding:0 10px 9px}.nav{width:100%;text-align:left;border:0;color:#dce9e2;background:transparent;display:flex;align-items:center;gap:12px;padding:11px 12px;border-radius:8px;margin-bottom:3px;font-weight:500}.nav:hover{background:#ffffff13}.nav.active{background:#ffffff20;color:#fff}.navicon{width:18px;text-align:center;font-size:16px}.sidefoot{margin-top:auto;border-top:1px solid #ffffff20;padding:15px 8px 4px;color:#b7cdc3;font-size:11px;line-height:1.6}.sidefoot b{display:block;color:#f1f7f3;font-size:12px;margin-bottom:3px}.main{min-width:0;padding:31px clamp(18px,4vw,54px) 48px;max-width:1600px;width:100%;margin:0 auto}.topbar{display:flex;justify-content:space-between;align-items:flex-start;gap:20px;margin-bottom:24px}.eyebrow{text-transform:uppercase;letter-spacing:.13em;color:#71887c;font-size:10px;font-weight:700}.page-title{font:500 30px/1.2 Georgia,serif;margin:5px 0}.page-subtitle{margin:5px 0 0;color:var(--muted);font-size:13px}.top-actions{display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end}.button{border:1px solid var(--line);background:#fff;color:var(--ink);padding:9px 13px;border-radius:8px;font-weight:650;font-size:12px;display:inline-flex;gap:7px;align-items:center;justify-content:center}.button:hover{border-color:#a2b9ad;background:#fbfdfb}.button.primary{background:var(--green);border-color:var(--green);color:white}.button.primary:hover{background:var(--green2)}.button.danger{color:var(--red);border-color:#efd7d3}.button.small{padding:6px 9px;font-size:11px}.metrics{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin:20px 0 22px}.metric{background:#fff;border:1px solid var(--line);border-radius:10px;padding:15px 17px}.metricline{display:flex;justify-content:space-between;align-items:center;font-size:11px;color:#66766f}.metricicon{color:#6d9382;font-size:16px}.metricvalue{font:500 25px Georgia,serif;margin:10px 0 1px;font-variant-numeric:tabular-nums}.metricnote{font-size:10px;color:#8a9691}.panel{background:#fff;border:1px solid var(--line);border-radius:11px;overflow:hidden}.panelhead{display:flex;justify-content:space-between;gap:15px;align-items:center;padding:15px 17px;border-bottom:1px solid var(--line)}.panelhead h2{font:500 19px Georgia,serif;margin:0}.panelhead p{margin:2px 0 0;font-size:11px;color:var(--muted)}.toolbar{display:flex;gap:9px;align-items:center;flex-wrap:wrap;padding:12px 14px;border-bottom:1px solid var(--line)}.searchbox{position:relative;flex:1;min-width:190px}.searchbox span{position:absolute;left:10px;top:8px;color:#84938c}.searchbox input{padding-left:31px;width:100%}input,select,textarea{border:1px solid #dce4df;border-radius:7px;padding:8px 10px;background:#fff;color:var(--ink);font-size:12px;outline:none}input:focus,select:focus,textarea:focus{border-color:#6d9f88;box-shadow:0 0 0 3px #4e99751b}.toolbar select{min-width:140px}.table-wrap{overflow:auto}.table{border-collapse:collapse;width:100%;min-width:820px}.table th{text-align:left;background:#fbfcfb;color:#78857f;font-size:9px;letter-spacing:.1em;text-transform:uppercase;padding:11px 14px;border-bottom:1px solid var(--line);white-space:nowrap}.table td{padding:12px 14px;border-bottom:1px solid #edf0ee;font-size:12px;vertical-align:middle}.table tr:last-child td{border-bottom:0}.mainname{font-weight:650;color:#273931}.sub{font-size:10px;color:#87938e;margin-top:2px}.money{white-space:nowrap;font-variant-numeric:tabular-nums;font-weight:650}.badge{display:inline-flex;align-items:center;padding:4px 8px;border-radius:20px;font-size:10px;white-space:nowrap;background:#eef1ef;color:#67736e}.badge.judicial{background:var(--blue);color:#555b91}.badge.extra{background:#e8f3ec;color:#367350}.badge.agreement{background:#eef0fa;color:#585e97}.badge.settled{background:#e5f3eb;color:#2f764a}.badge.overdue{background:#fae9e6;color:#a4463a}.badge.suspended{background:#f6f0df;color:#866a25}.row-actions{display:flex;gap:4px;white-space:nowrap;align-items:center}.iconbtn{border:0;background:transparent;color:#64756d;border-radius:6px;padding:6px}.iconbtn:hover{background:#edf3ef}.empty{padding:45px 16px;text-align:center;color:var(--muted);font-size:12px}.empty b{display:block;color:var(--ink);font-size:14px;margin-bottom:5px}.filterbar{display:grid;grid-template-columns:repeat(3,minmax(145px,1fr));gap:9px;padding:13px 15px;border-bottom:1px solid var(--line)}.filterbar label,.field label{display:flex;flex-direction:column;gap:5px;font-size:10px;font-weight:700;color:#5e7067}.filterbar input,.filterbar select{width:100%}.report-summary{padding:12px 16px;font-size:11px;color:#6f7e77;border-bottom:1px solid var(--line)}.report-total{font-weight:700;color:var(--green)}.notice{border:1px solid #e9dfc3;background:#fbf8ef;border-radius:9px;padding:11px 14px;color:#75683e;font-size:11px;margin-top:17px}.notice b{color:#5b512e}.modalback{position:fixed;inset:0;background:#10241dcc;display:none;align-items:center;justify-content:center;padding:16px;z-index:20}.modalback.show{display:flex}.modal{width:min(740px,100%);max-height:95vh;overflow:auto;background:#fff;border-radius:13px;box-shadow:var(--shadow)}.modalhead{position:sticky;top:0;z-index:1;background:#fff;border-bottom:1px solid var(--line);padding:18px 22px 14px;display:flex;justify-content:space-between;gap:12px}.modalhead h2{font:500 22px Georgia,serif;margin:0}.modalhead p{font-size:11px;color:var(--muted);margin:3px 0 0}.close{border:0;background:transparent;color:#66766f;font-size:23px;line-height:1;padding:0 4px;align-self:flex-start}.formbody{padding:18px 22px 22px}.formgrid{display:grid;grid-template-columns:1fr 1fr;gap:13px}.field{display:flex;flex-direction:column;gap:5px}.field.full{grid-column:1/-1}.field label{display:block}.field input,.field select,.field textarea{width:100%;padding:9px 10px}.field textarea{resize:vertical;min-height:66px}.formfoot{display:flex;justify-content:space-between;gap:9px;align-items:center;margin-top:18px}.foot-right{display:flex;gap:8px}.cardgrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.data-card{padding:15px 16px;background:white;border:1px solid var(--line);border-radius:10px}.data-card h3{margin:0;font-size:13px}.data-card p{margin:4px 0;color:var(--muted);font-size:11px}.memberline{display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:1px solid var(--line);font-size:12px}.memberline:last-child{border:0}.installment-list{padding:0 18px 14px}.installment-row{display:grid;grid-template-columns:40px 1fr 1fr auto auto;align-items:center;gap:8px;padding:9px 0;border-bottom:1px solid #edf0ee;font-size:11px}.installment-row:last-child{border:0}.event-list{padding:12px}.event{padding:8px 0 8px 13px;border-left:2px solid #d9e6de;font-size:11px}.event time{display:block;color:#8b9691;font-size:10px}.toast{position:fixed;bottom:19px;right:19px;z-index:40;max-width:min(450px,calc(100vw - 38px));padding:11px 15px;color:#fff;background:#173f37;border-radius:8px;box-shadow:var(--shadow);font-size:12px;opacity:0;transform:translateY(8px);transition:.2s;pointer-events:none}.toast.show{opacity:1;transform:translateY(0)}.fileinput{display:none}.localmark{display:inline-flex;align-items:center;gap:6px;font-size:10px;color:#74837b;background:#edf3ef;border-radius:20px;padding:5px 9px}.localmark span{color:#3a8b60}.authscreen{min-height:100vh;display:grid;place-items:center;padding:20px;background:radial-gradient(ellipse at 20% 20%,#e2eee7 0,transparent 40%),radial-gradient(ellipse at 82% 80%,#ece7d8 0,transparent 42%),var(--paper)}.authcard{width:min(530px,100%);background:#fff;border:1px solid var(--line);border-radius:15px;padding:30px;box-shadow:var(--shadow)}.authbrand{display:flex;align-items:center;gap:10px;color:var(--green);font-weight:750;font-size:14px;letter-spacing:.06em;margin-bottom:23px}.authcard h1{font:500 27px Georgia,serif;margin:0 0 5px}.authcard>p{font-size:12px;color:var(--muted);margin:0 0 19px}.authform{display:grid;gap:12px}.authform label{font-size:11px;font-weight:700;color:#607169;display:grid;gap:5px}.authform input{padding:11px 12px;width:100%}.helptext{font-size:10px!important;line-height:1.5!important;margin-top:14px!important}
@media(max-width:950px){.layout{grid-template-columns:1fr}.sidebar{position:static;height:auto;padding:11px 10px;flex-direction:row;align-items:center;gap:5px;overflow:auto}.brand{margin:0 8px 0 0;flex:0 0 auto}.brand small,.side-label,.sidefoot{display:none}.nav{width:auto;flex:0 0 auto;margin:0;padding:9px 10px}.navicon{display:none}.main{padding-top:20px}.metrics{grid-template-columns:repeat(2,1fr)}}@media(max-width:640px){.sidebar{gap:3px;padding:9px 6px}.brand{font-size:11px;gap:6px}.logo{width:30px;height:30px}.nav{font-size:10px;padding:8px}.topbar{display:block}.top-actions{justify-content:flex-start;margin-top:13px}.page-title{font-size:27px}.metrics{gap:8px}.metric{padding:12px}.metricvalue{font-size:22px}.toolbar select{flex:1;min-width:125px}.filterbar{grid-template-columns:1fr 1fr}.formgrid{grid-template-columns:1fr}.field.full{grid-column:auto}.formbody{padding:16px}.modalhead{padding:16px}.formfoot{align-items:stretch;flex-direction:column}.foot-right{justify-content:flex-end}.formfoot>.button{align-self:flex-start}.authcard{padding:23px}.cardgrid{grid-template-columns:1fr}.installment-row{grid-template-columns:32px 1fr 1fr}.installment-row>*:nth-child(n+4){grid-column:2/-1;justify-self:end}}
@media print{.sidebar,.top-actions,.toolbar,.panelhead button,.notice,.iconbtn,.row-actions .button{display:none!important}.layout{display:block}.main{padding:0;max-width:none}.panel{border:0}.table{min-width:0}.table th,.table td{padding:7px;font-size:9px}.page-title{font-size:22px}.metrics{grid-template-columns:repeat(4,1fr)}}
</style></head>
<body>
<div id="root"></div><div class="modalback" id="modalBack"><div class="modal" id="modal"></div></div><div class="toast" id="toast"></div><input class="fileinput" type="file" id="importFile" accept=".json,application/json">
<script>
(()=>{'use strict';
const $=id=>document.getElementById(id);let db,view='overview',toastTimer;let shareToken=decodeURIComponent(location.hash.slice(1)),cloudRevision=0,lastSyncedSnapshot='',cloudReady=false,localDirty=false,syncBusy=false,localChangeVersion=0;
const TYPES=['Nota promissória','Boleto','Duplicata','Cheque','Confissão de Dívida','Contrato de prestação de serviços'];const STATUS={open:'Em aberto',agreement:'Em acordo',settled:'Quitada',suspended:'Suspensa'};const PERIODS={weekly:['1','weeks','Semanal'],fortnightly:['2','weeks','Quinzenal'],monthly:['1','months','Mensal'],bimonthly:['2','months','Bimestral'],quarterly:['3','months','Trimestral'],halfyearly:['6','months','Semestral'],yearly:['1','years','Anual']};const emptyDb=()=>({debtors:[],creditors:[],cases:[],agreements:[],installments:[],events:[]});
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));function uid(){return globalThis.crypto?.randomUUID?.()||('id-'+Date.now().toString(36)+'-'+Math.random().toString(36).slice(2,10))}function today(){let d=new Date(),z=n=>String(n).padStart(2,'0');return `${d.getFullYear()}-${z(d.getMonth()+1)}-${z(d.getDate())}`}function money(n){return Number(n||0).toLocaleString('pt-BR',{style:'currency',currency:'BRL'})}function date(v){if(!v)return '—';let [y,m,d]=String(v).slice(0,10).split('-');return y&&m&&d?`${d}/${m}/${y}`:'—'}function toast(s){let el=$('toast');el.textContent=s;el.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>el.classList.remove('show'),2900)}function persist(){if(!cloudReady){toast('Aguarde a conexão antes de salvar.');return}localDirty=true;localChangeVersion++;render();clearTimeout(window.acervoSyncTimer);window.acervoSyncTimer=setTimeout(syncCloud,250)}function migrateLegacy(rows){let data=emptyDb(),people=new Map(),clients=new Map();for(const old of rows||[]){let debtorName=String(old.debtor||'Devedor sem nome'),creditorName=String(old.creditor||'Credor sem nome'),dk=debtorName.trim().toLocaleLowerCase('pt-BR'),ck=creditorName.trim().toLocaleLowerCase('pt-BR');if(!people.has(dk)){let p={id:old.debtorId||uid(),name:debtorName,cpf:String(old.cpf||'').replace(/\D/g,''),phone:old.phone||'',address:old.address||'',email:old.email||'',notes:'',archived:false,createdAt:old.createdAt||new Date().toISOString()};people.set(dk,p);data.debtors.push(p)}if(!clients.has(ck)){let p={id:old.creditorId||uid(),name:creditorName,document:'',phone:'',email:'',address:'',notes:'',archived:false,createdAt:old.createdAt||new Date().toISOString()};clients.set(ck,p);data.creditors.push(p)}data.cases.push({id:old.id||uid(),debtorId:people.get(dk).id,creditorId:clients.get(ck).id,type:old.kind||'Boleto',situation:old.stage||'Extrajudicial',status:old.status==='paid'||old.status==='settled'?'settled':'open',amount:Number(old.amount||0),due:old.due||today(),process:old.reference||'',notes:old.notes||'',createdAt:old.createdAt||new Date().toISOString(),settledAt:''})}return data}
function normalizeCloudData(value){let result={...emptyDb(),...(value&&typeof value==='object'?value:{})};for(const key of Object.keys(emptyDb()))if(!Array.isArray(result[key]))result[key]=[];return result}
function mergeCloudData(base,local,remote){let merged={};for(const key of Object.keys(emptyDb())){let b=base[key]||[],l=local[key]||[],r=remote[key]||[],bm=new Map(b.map(x=>[x.id,x])),lm=new Map(l.map(x=>[x.id,x])),rm=new Map(r.map(x=>[x.id,x])),ids=[...new Set([...l,...r,...b].map(x=>x.id))],out=[];for(const id of ids){let before=bm.get(id),ours=lm.get(id),theirs=rm.get(id),oursChanged=JSON.stringify(ours)!==JSON.stringify(before),chosen=oursChanged?ours:theirs;if(chosen!==undefined)out.push(chosen)}merged[key]=out}return merged}
function cloudHeaders(){return{'Authorization':'Bearer '+shareToken,'Content-Type':'application/json'}}
async function getCloudData(){let response=await fetch('/api/data',{method:'GET',headers:cloudHeaders(),cache:'no-store'});if(!response.ok)throw new Error(response.status===401?'Este link não tem autorização para os dados.':'Não foi possível conectar ao arquivo compartilhado.');return response.json()}
async function putCloudData(data,revision){let response=await fetch('/api/data',{method:'PUT',headers:cloudHeaders(),body:JSON.stringify({data,revision})});if(response.status===409)return{conflict:true};if(!response.ok){let body={};try{body=await response.json()}catch{}throw new Error(body.error||'Não foi possível sincronizar os registros.')}return response.json()}
async function syncCloud(){if(!cloudReady||!localDirty||syncBusy)return;syncBusy=true;let startedAt=localChangeVersion,base=normalizeCloudData(JSON.parse(lastSyncedSnapshot||'{}')),payload=normalizeCloudData(db);try{let result=await putCloudData(payload,cloudRevision);if(result.conflict){let latest=await getCloudData(),remote=normalizeCloudData(latest.data),firstMerge=mergeCloudData(base,payload,remote),currentMerge=mergeCloudData(payload,db,firstMerge);db=currentMerge;render();cloudRevision=Number(latest.revision);payload=normalizeCloudData(db);result=await putCloudData(payload,cloudRevision);if(result.conflict)throw new Error('Houve alterações simultâneas. Aguarde a atualização e tente salvar novamente.')}cloudRevision=Number(result.revision);lastSyncedSnapshot=JSON.stringify(payload);localDirty=localChangeVersion!==startedAt;if(localDirty){clearTimeout(window.acervoSyncTimer);window.acervoSyncTimer=setTimeout(syncCloud,400)}}catch(error){localDirty=true;toast(error.message||'Falha ao sincronizar. Mantenha esta página aberta e tente novamente.');clearTimeout(window.acervoSyncTimer);window.acervoSyncTimer=setTimeout(syncCloud,10000)}finally{syncBusy=false;if(localDirty&&!window.acervoSyncTimer)window.acervoSyncTimer=setTimeout(syncCloud,1000)}}
async function refreshCloud(){if(!cloudReady||localDirty||syncBusy)return;try{let latest=await getCloudData();if(Number(latest.revision)!==cloudRevision){let base=normalizeCloudData(JSON.parse(lastSyncedSnapshot||'{}'));db=mergeCloudData(base,db,normalizeCloudData(latest.data));cloudRevision=Number(latest.revision);lastSyncedSnapshot=JSON.stringify(db);render()}}catch(error){console.warn('Sincronização online indisponível',error)}}
function showOnlineGate(title,message){$('root').innerHTML='<main style="max-width:640px;margin:12vh auto;padding:32px;font:16px system-ui;color:#243333;background:#fff;border:1px solid #ddd;border-radius:16px"><h1 style="font:32px Georgia,serif">'+title+'</h1><p>'+message+'</p></main>'}
async function startOnlineApp(){if(!shareToken){showOnlineGate('Acesso pelo link completo','Abra o endereço compartilhado por quem administra o acervo. Os dados só podem ser acessados com o código que acompanha o link.');return}try{let state=await getCloudData();db=normalizeCloudData(state.data);cloudRevision=Number(state.revision);lastSyncedSnapshot=JSON.stringify(db);cloudReady=true;render();window.setInterval(refreshCloud,8000)}catch(error){showOnlineGate('Não foi possível abrir o acervo',error.message||'Verifique o link e a conexão com a internet.')}}function load(){return emptyDb()}function modal(html){$('modal').innerHTML=html;$('modalBack').classList.add('show')}function closeModal(){$('modalBack').classList.remove('show');$('modal').innerHTML=''}function badgeStatus(s,due){let key=s==='open'&&due&&due<today()?'overdue':s;return `<span class="badge ${key}">${key==='overdue'?'Vencida':STATUS[key]||key}</span>`}function situationBadge(s){return `<span class="badge ${s==='Judicial'?'judicial':'extra'}">${esc(s)}</span>`}
function casesWithPeople(){return db.cases.map(c=>({...c,scheduleItems:c.scheduleItems||[],chargeMode:c.chargeMode||'single',debtor:db.debtors.find(x=>x.id===c.debtorId)||{},creditor:db.creditors.find(x=>x.id===c.creditorId)||{},agreement:db.agreements.find(a=>a.caseId===c.id&&a.active)||null}))}function effectiveDue(c){if(c.status==='agreement'&&c.agreement){let due=db.installments.filter(i=>i.agreementId===c.agreement.id&&!i.paidAt).sort((a,b)=>a.due.localeCompare(b.due));if(due.length)return due[0].due}if(c.chargeMode==='installments'){let next=(c.scheduleItems||[]).filter(i=>!i.paidAt).sort((a,b)=>a.due.localeCompare(b.due))[0];if(next)return next.due}if(c.chargeMode==='fixed'&&c.firstDue)return c.firstDue;return c.due}function balance(c){if(c.status==='settled'||c.status==='suspended')return 0;if(c.status==='agreement'&&c.agreement)return db.installments.filter(i=>i.agreementId===c.agreement.id&&!i.paidAt).reduce((s,i)=>s+Number(i.amount||0),0);if(c.chargeMode==='installments')return (c.scheduleItems||[]).filter(i=>!i.paidAt).reduce((s,i)=>s+Number(i.amount||0),0);return Number(c.amount||0)}function moneyOptional(n){return n===null||n===undefined||n===''?'—':money(n)}function addScheduleDate(start,every,unit,index){let d=new Date(start+'T12:00:00'),n=every*index;if(unit==='days'){d.setDate(d.getDate()+n);return d.toISOString().slice(0,10)}if(unit==='weeks'){d.setDate(d.getDate()+7*n);return d.toISOString().slice(0,10)}let months=unit==='years'?12*n:n,month=new Date(d.getFullYear(),d.getMonth()+months,1),last=new Date(month.getFullYear(),month.getMonth()+1,0).getDate();return new Date(month.getFullYear(),month.getMonth(),Math.min(d.getDate(),last)).toISOString().slice(0,10)}function periodSpec(value,every,unit){return PERIODS[value]?[Number(PERIODS[value][0]),PERIODS[value][1]]:[Number(every||1),unit||'months']}function periodText(c){if(!c)return'Única';if(c.status==='agreement'&&c.agreement)return periodText({chargeMode:'installments',installmentCount:c.agreement.count,periodicity:c.agreement.periodicity||'monthly',periodEvery:c.agreement.periodEvery||1,periodUnit:c.agreement.periodUnit||'months'});if(c.chargeMode==='single')return'Única';let name=PERIODS[c.periodicity]?.[2]||(c.periodEvery===1?'Personalizada':'A cada '+c.periodEvery);if(c.periodicity==='custom')name='A cada '+c.periodEvery+' '+({days:'dia(s)',weeks:'semana(s)',months:'mês(es)',years:'ano(s)'}[c.periodUnit]||'mês(es)');return c.chargeMode==='fixed'?'Fixa · '+name:'Parcelada · '+(c.installmentCount||c.scheduleItems?.length||0)+' parcelas · '+name}const NAV=[['overview','⌂','Visão geral'],['cases','▤','Cobranças'],['debtors','♙','Devedores'],['creditors','▧','Credores'],['reports','▥','Relatórios'],['settings','⚙','Online']];function goto(v){view=v;render();window.scrollTo({top:0,behavior:'smooth'})}
function render(){let title={overview:'Visão geral',cases:'Cobranças',debtors:'Devedores',creditors:'Credores',reports:'Relatórios',settings:'Acesso e backups'}[view]||'Visão geral';$('root').innerHTML=`<div class="layout"><aside class="sidebar"><div class="brand"><span class="logo">A</span><span>ACERVO<small>/ acesso compartilhado</small></span></div><div class="side-label">Minha carteira</div>${NAV.map(n=>`<button class="nav ${view===n[0]?'active':''}" data-nav="${n[0]}"><span class="navicon">${n[1]}</span>${n[2]}</button>`).join('')}<div class="sidefoot"><b>Carteira compartilhada online</b>Link de acesso · sincronização online</div></aside><main class="main"><header class="topbar"><div><div class="eyebrow">Assessoria de cobrança</div><h1 class="page-title">${title}</h1><p class="page-subtitle">${{overview:'Resumo da carteira compartilhada e dos próximos vencimentos.',cases:'Organize títulos, processos, acordos e parcelas.',debtors:'Cadastre cada devedor uma vez para reutilizar depois.',creditors:'Seus clientes de assessoria de cobrança.' ,reports:'Consulte por nomes e períodos escolhidos por você.',settings:'Registros sincronizados para quem tem o link.'}[view]}</p></div><div class="top-actions"><span class="localmark"><span>●</span> compartilhado online</span><button class="button" data-action="import">↑ Importar backup</button><button class="button" data-action="backup">↓ Exportar backup</button><button class="button primary" data-action="new-case">＋ Nova cobrança</button></div></header><div id="content"></div></main></div>`;document.querySelectorAll('[data-nav]').forEach(b=>b.onclick=()=>goto(b.dataset.nav));renderView()}
function metric(label,value,note,icon){return `<div class="metric"><div class="metricline">${label}<span class="metricicon">${icon}</span></div><div class="metricvalue">${value}</div><div class="metricnote">${note}</div></div>`}
function caseTable(rows){return `<div class="table-wrap"><table class="table"><thead><tr><th>Devedor</th><th>Credor</th><th>Tipo de dívida</th><th>Forma</th><th>Vencimento</th><th>Valor original / acordo</th><th>Situação</th><th>Status</th><th></th></tr></thead><tbody>${rows.map(c=>`<tr><td><div class="mainname">${esc(c.debtor.name||'—')}</div><div class="sub">${c.debtor.cpf?'CPF '+esc(c.debtor.cpf):''}</div></td><td><div class="mainname">${esc(c.creditor.name||'—')}</div></td><td>${esc(c.type)}</td><td>${esc(periodText(c))}</td><td>${date(effectiveDue(c))}</td><td class="money">${moneyOptional(c.status==='agreement'&&c.agreement?c.agreement.total:c.amount)}</td><td>${situationBadge(c.situation)}</td><td>${badgeStatus(c.status,effectiveDue(c))}</td><td><div class="row-actions"><button class="iconbtn" title="Detalhes" data-action="detail-case" data-id="${c.id}">◉</button><button class="iconbtn" title="Editar" data-action="edit-case" data-id="${c.id}">✎</button><button class="iconbtn" title="Acordo e parcelas" data-action="agreement" data-id="${c.id}">▤</button></div></td></tr>`).join('')}</tbody></table></div>`}function overview(){let rows=casesWithPeople(),active=rows.filter(x=>!['settled','suspended'].includes(x.status)),over=active.filter(x=>effectiveDue(x)&&effectiveDue(x)<today()).length,jud=active.filter(x=>x.situation==='Judicial').length,total=active.reduce((s,x)=>s+balance(x),0),recent=active.slice().sort((a,b)=>effectiveDue(a).localeCompare(effectiveDue(b))).slice(0,8);return `<section class="metrics">${metric('Saldo em aberto',money(total),`${active.length} cobrança(s) ativa(s)`,'◉')}${metric('Vencidas',over,'Precisam de acompanhamento','◷')}${metric('Judiciais',jud,'Em acompanhamento judicial','⚖')}${metric('Credores',db.creditors.filter(x=>!x.archived).length,'Clientes cadastrados','♙')}</section><section class="panel"><div class="panelhead"><div><h2>Próximas cobranças</h2><p>Ordenadas pela data de vencimento</p></div><button class="button primary" data-action="new-case">＋ Nova cobrança</button></div>${recent.length?caseTable(recent):`<div class="empty"><b>Seu arquivo começa aqui</b>Lance uma cobrança diretamente; o credor precisa estar cadastrado.</div>`}</section><div class="notice"><b>Privacidade:</b> os registros são sincronizados pelo banco online e ficam acessíveis a quem tem o link completo. Exporte backups regularmente e mantenha-os em local protegido.</div>`}
function casesView(){return `<section class="panel"><div class="panelhead"><div><h2>Carteira de cobranças</h2><p>Pesquise por devedor, credor, CPF, título ou processo.</p></div><button class="button primary" data-action="new-case">＋ Nova cobrança</button></div><div class="toolbar"><div class="searchbox"><span>⌕</span><input id="caseSearch" placeholder="Buscar na carteira"></div><select id="caseSituation"><option value="">Judicial e extrajudicial</option><option>Judicial</option><option>Extrajudicial</option></select><select id="caseStatus"><option value="">Todos os status</option><option value="open">Em aberto</option><option value="agreement">Em acordo</option><option value="settled">Quitada</option><option value="suspended">Suspensa</option></select></div><div id="caseList">${caseTable(casesWithPeople())}</div><div class="empty hidden" id="caseEmpty"><b>Nenhuma cobrança encontrada</b>Altere a busca ou os filtros.</div></section>`}
function peopleView(kind){let debtor=kind==='debtor',items=debtor?db.debtors:db.creditors;return `<section class="panel"><div class="panelhead"><div><h2>${debtor?'Devedores':'Credores / clientes'}</h2><p>${debtor?'O cadastro do devedor pode ser escolhido em cobranças futuras.':'Cadastre seus clientes uma vez e selecione-os ao abrir uma cobrança.'}</p></div><button class="button primary" data-action="new-${kind}">＋ Novo ${debtor?'devedor':'credor'}</button></div><div class="toolbar"><div class="searchbox"><span>⌕</span><input id="peopleSearch" placeholder="Buscar por nome, documento ou contato"></div><select id="peopleArchive"><option value="active">Ativos</option><option value="all">Todos</option><option value="archived">Arquivados</option></select></div><div class="table-wrap"><table class="table"><thead><tr><th>Nome</th><th>${debtor?'CPF':'CPF / CNPJ'}</th><th>Telefone</th><th>${debtor?'Endereço':'E-mail'}</th><th>Cobranças</th><th>Cadastro</th><th></th></tr></thead><tbody id="peopleRows"></tbody></table></div><div class="empty hidden" id="peopleEmpty"><b>Nenhum cadastro encontrado</b>Adicione um novo registro para começar.</div></section>`}
